# Copy to .env to override the local defaults in docker-compose.yml.
# These values are for local development only. Real environments get theirs from
# AWS Secrets Manager through scripts/deploy.sh.
POSTGRES_USER=leadpipe
POSTGRES_PASSWORD=leadpipe-local
POSTGRES_DB=leadpipe
API_KEY=local-dev-key
API_PORT=8000
LOG_LEVEL=INFO
TAG=dev
